generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- TES MODÈLES AUTH (Conservés) ---

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  equipmentSets EquipmentSet[]

  @@map("user")
}

model EquipmentSet {
  id                 Int         @id @default(autoincrement())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String      @default("Équipement")
  includeInObjective Boolean     @default(true)
  equipments         Equipment[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("equipment_set")
}

model Equipment {
  id           Int          @id @default(autoincrement())
  setId        Int
  set          EquipmentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  slot         String       // "left-0", "right-2", "bottom-5", etc.
  itemData     Json         // Les données de l'item DofusDB
  price        Int          @default(0)
  bought       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([setId, slot])
  @@map("equipment")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// --- TON MODÈLE ITEM SIMPLIFIÉ ---

model Item {
  id          Int      @id @default(autoincrement())
  nom         String
  prixAchat   Float
  prixVente   Float?   @default(0)
  benefit     Float    // Attention: champ obligatoire, on le calculera si manquant
  createdAt   DateTime @default(now())
  soldAt      DateTime? // Date de vente (null si pas encore vendu)
  statusVente Boolean  @default(false)
  category    String   @default("general")

  imageUrl    String?
  type        String?
  superType   String?

  unit        Float?
  size        Float?

  kamasAvant  Float?
  kamasApres  Float?
}